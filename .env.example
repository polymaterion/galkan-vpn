# Telegram
TELEGRAM_TOKEN=
ADMIN_IDS=

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vpnbot
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Internal API auth between bot and billing
BILLING_SECRET_KEY=change_me_long_random_secret
BILLING_BASE_URL=http://billing:8000

# Public landing page behind the "Открыть в Amnezia" button (api/routers/connect.py).
# Must be reachable from the internet — set this to http://<your-server-ip>:<PUBLIC_PORT>
# (or https://your-domain if you put a reverse proxy with TLS in front of it).
# PUBLIC_PORT is the host port docker-compose publishes billing on (default 8080) —
# remember to open it in your firewall: ufw allow 8080/tcp
PUBLIC_BASE_URL=http://CHANGE_ME_SERVER_IP:8080
PUBLIC_PORT=8080

# Payments
PLAN_PRICE_STARS=100
CRYPTOPAY_TOKEN=
CRYPTOPAY_NETWORK=mainnet
PLAN_PRICE_USDT=3.00

# Subscription plan
PLAN_DURATION_DAYS=30

# VPN servers for seed.py — only servers with BOTH *_URL and *_KEY actually
# set get created. Leave VPN_SERVER2_* empty/unset if you only run one
# server (the normal single-VPS setup) — seed.py will skip it automatically,
# no phantom second server gets created. Add VPN_SERVER2_URL/KEY here later
# if you deploy a second VPN node, or add it anytime via the bot's
# /add_server command instead (works without touching .env or re-seeding).
#
# IMPORTANT: amnezia-api's docker-proxy is bound to 127.0.0.1 on the host
# (see amnezia-api's docker-compose.yml — "127.0.0.1:4001->4001/tcp"), so
# it does NOT accept connections arriving from other containers even via
# the host's external IP. billing/worker are joined to amnezia-api's own
# docker network (see the amnezia_api_net entry in this project's
# docker-compose.yml) specifically so they can reach it by container name
# instead — use that here, not an IP:
VPN_SERVER1_URL=http://amnezia-api:4001
VPN_SERVER1_KEY=
# VPN_SERVER2_URL=
# VPN_SERVER2_KEY=

# App
ENVIRONMENT=production
LOG_LEVEL=INFO
SUPPORT_LINK=https://t.me/your_support
